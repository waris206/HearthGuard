{
  "name": "@hearthguard/server",
  "version": "1.0.0",
  "private": true,
  "description": "HearthGuard MCP server, deterministic risk engine and investigation orchestrator",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
